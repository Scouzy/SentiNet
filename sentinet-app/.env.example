# ─── Configuration SentiNet (serveur) ────────────────────────
# Copier ce fichier en `.env` et adapter les valeurs.
# Le fichier `.env` ne doit JAMAIS être commité (voir .gitignore).

# Port de l'API backend (Express + WebSocket)
PORT=3010

# Origine autorisée pour CORS en production (URL du frontend)
CORS_ORIGIN=http://localhost:5210

# Environnement d'exécution : development | production
NODE_ENV=development

# Sel de pseudonymisation (SHA-256) des données personnelles — RGPD §8
# Générer une valeur aléatoire longue et la garder secrète.
PSEUDONYM_SALT=change-me-avec-une-valeur-aleatoire-longue

# Secret de signature des jetons de session / MFA (otplib)
SESSION_SECRET=change-me-avec-une-valeur-aleatoire-longue
