# ─── Configuration SentiNet (serveur) ────────────────────────
# Copier ce fichier en `.env` et adapter les valeurs.
# Le fichier `.env` ne doit JAMAIS être commité (voir .gitignore).

# Interface d'écoute du backend.
#   127.0.0.1 = accessible uniquement en local / via reverse proxy (recommandé en prod)
#   0.0.0.0   = accessible depuis le réseau (dev multi-postes)
HOST=127.0.0.1

# Port de l'API backend (Express + WebSocket)
PORT=3010

# Origine autorisée pour CORS (URL publique du frontend)
#   En prod : https://sentinet.devantiq.com
CORS_ORIGIN=http://localhost:5210

# Domaine supervisé affiché pour la sonde locale (ex. devantiq.com).
# Si vide, déduit de l'hôte de CORS_ORIGIN.
SERVER_DOMAIN=

# Environnement d'exécution : development | production
NODE_ENV=development

# Application effective des blocages pare-feu sous Linux (iptables) :
#   false = mode sûr, les blocages sont journalisés sans toucher le pare-feu de l'hôte
#   true  = SentiNet applique réellement les règles iptables (nécessite root/cap_net_admin)
FIREWALL_ENFORCE=false

# Clé partagée pour l'authentification des agents-sondes distants (Phase 3).
# Générer : openssl rand -hex 24 — la même valeur doit être configurée sur chaque agent.
AGENT_KEY=

# Alertes de réputation issues des flux publics d'IoC (Feodo/SSLBL/Blocklist.de).
#   false = par défaut : les correspondances servent uniquement d'enrichissement/contexte
#           (pas d'alerte autonome) → élimine le bruit sur une interface publique
#   true  = réactive les alertes « IoC — réputation (flux public) » (severity: moyen)
# Les détections comportementales (Beaconing C2, exfiltration…) et les IoC curés
# (critiques) restent toujours actifs, indépendamment de ce réglage.
IOC_FEED_ALERTS=false

# Sel de pseudonymisation (SHA-256) des données personnelles — RGPD §8
# Générer une valeur aléatoire longue et la garder secrète.
PSEUDONYM_SALT=change-me-avec-une-valeur-aleatoire-longue

# Secret de signature des jetons de session / MFA (otplib)
SESSION_SECRET=change-me-avec-une-valeur-aleatoire-longue
